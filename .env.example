# VMIS environment. Copy to .env and fill real values. Never commit .env.

# --- API ---
# Comma-free single secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VMIS_SECRET_KEY=change-me-to-a-long-random-string
VMIS_ACCESS_TOKEN_TTL_MINUTES=60

# --- Database ---
# Production: PostgreSQL (system of record). In-country / on-prem hosting per legal constraints.
VMIS_DATABASE_URL=postgresql+psycopg://vmis:vmis@localhost:5432/vmis

# Retention period for visitor personal data, in days (Data Protection and Privacy Act, 2019).
VMIS_PII_RETENTION_DAYS=365
# Redact PII past the retention window automatically at application start.
VMIS_RETENTION_ENFORCE_ON_START=true

# --- Alert thresholds (build prompt section 4.1) ---
# Hours a stay may run past ticket expiry before it counts as an overstay.
VMIS_OVERSTAY_GRACE_HOURS=6
# Hours an open visit may sit with no exit before it is flagged as a missed exit.
VMIS_MISSING_EXIT_HOURS=48

# First-run bootstrap management account (created only if no users exist). Change immediately.
VMIS_BOOTSTRAP_ADMIN_USERNAME=admin
VMIS_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
